# =========================================================
# OPTAV.IA - ESTEIRA IA & SCRAPER GOOGLE MAPS
# CONFIGURAÇÃO DE AMBIENTE PARA VPS (LINUX / WINDOWS)
# =========================================================

# 1. API KEY DA LLM (GEMINI AI / GOOGLE AI STUDIO)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. BANCO DE DADOS RELACIONAL POSTGRESQL
# Formato: postgresql://usuario:senha@localhost:5432/optavia_db
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/optavia_db

# 3. PORTA E SERVIDOR HTTP
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# 4. DEPLOYFLOW, DEPLOYHUB & MEOWHATS API (AUTOMATED DEPLOY, LLM PROXY & WHATSAPP)
DEPLOYFLOW_ENABLED=true
DEPLOYFLOW_API_KEY=sua_deployflow_api_key_aqui
DEPLOYFLOW_URL=https://api.deployflow.io/v1

# DEPLOYHUB LLM PROXY (Suporte Anthropic / Claude Code / OpenAI)
DEPLOYHUB_API_KEY=sk-ant-dh-live-sua_chave_deployhub_aqui
DEPLOYHUB_BASE_URL=https://api.deployhub.io/v1

MEOWHATS_API_URL=https://api.meowhats.com/v1
MEOWHATS_API_TOKEN=sua_meowhats_api_token_aqui
MEOWHATS_INSTANCE_ID=instancia_12345

# 5. AGENTES & SDR PADRÃO
SDR_DEFAULT_NAME="Lucas Mendes"
SDR_DEFAULT_TONE="informal"
